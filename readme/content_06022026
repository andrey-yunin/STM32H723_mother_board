│  77                                                                                                                                                        │
│  78 ## Шаг 1: Определение ID рецепта                                                                                                                       │
│  79                                                                                                                                                        │
│  80 Каждая новая команда-рецепт должна иметь уникальный идентификатор.                                                                                     │
│  81                                                                                                                                                        │
│  82 **Действие:**                                                                                                                                          │
│  83 1.  Откройте файл `App/Inc/Dispatcher/command_parser.h`.                                                                                               │
│  84 2.  В перечислении (enum) `RecipeID_t` добавьте новый идентификатор для вашей команды перед `RECIPE_MAX_ID`.                                           │
│  85                                                                                                                                                        │
│  86 **Пример:**                                                                                                                                            │
│  87 ```c                                                                                                                                                   │
│  88 typedef enum {                                                                                                                                         │
│  89     // ... существующие ID ...                                                                                                                         │
│  90     RECIPE_INITIALIZE_SYSTEM,                                                                                                                          │
│  91     RECIPE_NEW_COMMAND, // <-- Ваша новая команда                                                                                                      │
│  92     // --- [ADD_NEW_COMMAND] ---                                                                                                                       │
│  93     RECIPE_MAX_ID                                                                                                                                      │
│  94 } RecipeID_t;                                                                                                                                          │
│  95 ```                                                                                                                                                    │
│  96                                                                                                                                                        │
│  97 ## Шаг 2: Создание рецепта                                                                                                                             │
│  98                                                                                                                                                        │
│  99 Рецепт — это последовательность шагов (действий), которые должно выполнить устройство.                                                                 │
│ 100                                                                                                                                                        │
│ 101 **Действие:**                                                                                                                                          │
│ 102 1.  Откройте файл `App/Src/Dispatcher/recipe_store.c`.                                                                                                 │
│ 103 2.  Создайте статический массив `ProcessStep_t`, описывающий шаги для вашего рецепта.                                                                  │
│ 104 3.  Создайте глобальную переменную `const ProcessStep_t[]` для вашего рецепта.                                                                         │
│ 105                                                                                                                                                        │
│ 106 **Пример:**                                                                                                                                            │
│ 107 ```c                                                                                                                                                   │
│ 108 // Определение шагов для рецепта "Новая Команда"                                                                                                       │
│ 109 const ProcessStep_t g_recipe_new_command[] = {                                                                                                         │
│ 110     // Пример: шаг 1 - включить мотор 1 на 1000 тиков                                                                                                  │
│ 111     { .atomic_actions = (const AtomicAction_t[]){ { .action = ACTION_ROTATE_MOTOR, .params.rotate_motor = { .motor_id = 1, .steps = 1000, .speed = 500 │
│     } } }, .num_actions = 1 },                                                                                                                             │
│ 112     // Пример: шаг 2 - задержка на 500 мс                                                                                                              │
│ 113     { .atomic_actions = (const AtomicAction_t[]){ { .action = ACTION_WAIT_MS, .params.wait = { .delay_ms = 500 } } }, .num_actions = 1 },              │
│ 114     // Маркер конца рецепта                                                                                                                            │
│ 115     { .atomic_actions = NULL, .num_actions = 0 }                                                                                                       │
│ 116 };                                                                                                                                                     │
│ 117 ```                                                                                                                                                    │
