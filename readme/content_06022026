│  87 +                                                                                                                                                      │
│  88 + **Пример:**                                                                                                                                          │
│  89 + ```c                                                                                                                                                 │
│  90 + typedef enum {                                                                                                                                       │
│  91 +     // ... существующие ID ...                                                                                                                       │
│  92 +     RECIPE_INITIALIZE_SYSTEM,                                                                                                                        │
│  93 +     RECIPE_NEW_COMMAND, // <-- Ваша новая команда                                                                                                    │
│  94 +     // --- [ADD_NEW_COMMAND] ---                                                                                                                     │
│  95 +     RECIPE_MAX_ID                                                                                                                                    │
│  96 + } RecipeID_t;                                                                                                                                        │
│  97 + ```                                                                                                                                                  │
│  98 +                                                                                                                                                      │
│  99 + ## Шаг 2: Создание рецепта                                                                                                                           │
│ 100 +                                                                                                                                                      │
│ 101 + Рецепт — это последовательность шагов (действий), которые должно выполнить устройство.                                                               │
│ 102 +                                                                                                                                                      │
│ 103 + **Действие:**                                                                                                                                        │
│ 104 + 1.  Откройте файл `App/Src/Dispatcher/recipe_store.c`.                                                                                               │
│ 105 + 2.  Создайте статический массив `ProcessStep_t`, описывающий шаги для вашего рецепта.                                                                │
│ 106 + 3.  Создайте глобальную переменную `const ProcessStep_t[]` для вашего рецепта.                                                                       │
│ 107 +                                                                                                                                                      │
│ 108 + **Пример:**                                                                                                                                          │
│ 109 + ```c                                                                                                                                                 │
│ 110 + // Определение шагов для рецепта "Новая Команда"                                                                                                     │
│ 111 + const ProcessStep_t g_recipe_new_command[] = {                                                                                                       │
│ 112 +     // Пример: шаг 1 - включить мотор 1 на 1000 тиков                                                                                                │
│ 113 +     { .atomic_actions = (const AtomicAction_t[]){ { .action = ACTION_ROTATE_MOTOR, .params.rotate_motor = { .motor_id = 1, .motor_id_source =        │
│     PARAM_SOURCE_STATIC, .steps = 1000, .steps_source = PARAM_SOURCE_STATIC, .speed = 500, .speed_source = PARAM_SOURCE_STATIC } } }, .num_actions = 1 },  │
│ 114 +     // Пример: шаг 2 - задержка на 500 мс                                                                                                            │
│ 115 +     { .atomic_actions = (const AtomicAction_t[]){ { .action = ACTION_WAIT_MS, .params.wait = { .delay_ms = 500, .delay_ms_source =                   │
│     PARAM_SOURCE_STATIC } } }, .num_actions = 1 },                                                                                                         │
│ 116 +     // Маркер конца рецепта                                                                                                                          │
│ 117 +     { .atomic_actions = NULL, .num_actions = 0 }                                                                                                     │
│ 118 + };                                                                                                                                                   │
│ 119 + ```                                                                                                                                                  │
│ 120 + **Важно:** Для добавления динамических параметров, не забудьте указать соответствующий `ParamSource_t` для каждого параметра, а также добавить       │
│     необходимые поля `_source` в определения `AtomicAction_t` в `recipe_store.h`.                                                                          │
