│                                                                                                                                                                                                                                            │
│ // ...                                                                                                                                                                                                                                     │
│                                                                                                                                                                                                                                            │
│ bool Parameters_Parse(UniversalCommand_t* cmd, const uint8_t* raw_params, uint16_t params_len) {                                                                                                                                           │
│     bool success = true;                                                                                                                                                                                                                   │
│     switch (cmd->command_code) {                                                                                                                                                                                                           │
│         // ...                                                                                                                                                                                                                             │
