│ ## Шаг 4: Регистрация рецепта                                                                                                                                                                                                              │
│                                                                                                                                                                                                                                            │
│ Система должна знать, как найти ваш новый рецепт по его ID.                                                                                                                                                                                │
│                                                                                                                                                                                                                                            │
│ **Действие:**                                                                                                                                                                                                                              │
│ 1.  Откройте файл `App/Src/Dispatcher/recipe_store.c`.                                                                                                                                                                                     │
│ 2.  В функции `Recipe_Get`, добавьте `case` в `switch` для вашего нового `RecipeID_t`.                                                                                                                                                     │
│                                                                                                                                                                                                                                            │
│ **Пример:**                                                                                                                                                                                                                                │
│ ```c                                                                                                                                                                                                                                       │
│ const ProcessStep_t* Recipe_Get(RecipeID_t id) {                                                                                                                                                                                           │
│     switch (id) {                                                                                                                                                                                                                          │
│         // ... существующие case ...                                                                                                                                                                                                       │
│         case RECIPE_DISPENSER_WASH:                                                                                                                                                                                                        │
│             return g_recipe_dispenser_wash;                                                                                                                                                                                                │
│         case RECIPE_WASH_STATION_WASH: // <-- Пример для существующей команды                                                                                                                                                              │
│             return g_recipe_wash_station_wash;                                                                                                                                                                                             │
│         case RECIPE_NEW_COMMAND: // <-- Ваш новый case                                                                                                                                                                                     │
│             return g_recipe_new_command;                                                                                                                                                                                                   │
│         default:                                                                                                                                                                                                                           │
│             return NULL;                                                                                                                                                                                                                   │
│     }                                                                                                                                                                                                                                      │
│ }                                                                                                                                                                                                                                          │
│ ```                                                                                                                                                                                                                                        │
│                                                                                                                                                                                                                                            │
│ ## Шаг 5: Регистрация бинарной команды                                                                                                                                                                                                     │
│                                                                                                                                                                                                                                            │
│ Свяжите код бинарной команды (например, `0x2001`) с вашим ID рецепта.                                                                                                                                                                      │
│                                                                                                                                                                                                                                            │
│ **Действие:**                                                                                                                                                                                                                              │
│ 1.  Откройте файл `App/Src/Dispatcher/command_parser.c`.                                                                                                                                                                                   │
│ 2.  В массиве `recipe_command_table` добавьте новый дескриптор `RecipeCommandDescriptor_t`.                                                                                                                                                │
│                                                                                                                                                                                                                                            │
│ **Пример:**                                                                                                                                                                                                                                │
│ ```c                                                                                                                                                                                                                                       │
│ const RecipeCommandDescriptor_t recipe_command_table[] = {                                                                                                                                                                                 │
│     // ... существующие дескрипторы ...                                                                                                                                                                                                    │
│     {                                                                                                                                                                                                                                      │
│         .command_code = 0x4000, // WASH_STATION_WASH                                                                                                                                                                                       │
│         .min_params_len = 3,                                                                                                                                                                                                               │
│         .max_params_len = 3,                                                                                                                                                                                                               │
│         .recipe_id = RECIPE_WASH_STATION_WASH                                                                                                                                                                                              │
│     },                                                                                                                                                                                                                                     │
│     {                                                                                                                                                                                                                                      │
│         .command_code = 0x2001, // <-- Код вашей новой команды                                                                                                                                                                             │
│         .min_params_len = 7,    // motor_id(1) + steps(4) + speed(2) = 7 байт                                                                                                                                                              │
│         .max_params_len = 7,                                                                                                                                                                                                               │
│         .recipe_id = RECIPE_NEW_COMMAND                                                                                                                                                                                                    │
│     },                                                                                                                                                                                                                                     │
│ };                                                                                                                                                                                                                                         │
│ ```                                                                                                                                                                                                                                        │
