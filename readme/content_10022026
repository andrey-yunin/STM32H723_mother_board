│ 193 + **Пример:**                                                                                                                                                                                                                          │
│ 194 + ```c                                                                                                                                                                                                                                 │
│ 195 + const ProcessStep_t* Recipe_Get(RecipeID_t id) {                                                                                                                                                                                     │
│ 196 +     switch (id) {                                                                                                                                                                                                                    │
│ 197 +         // ... существующие case ...                                                                                                                                                                                                 │
│ 198 +         case RECIPE_DISPENSER_WASH:                                                                                                                                                                                                  │
│ 199 +             return g_recipe_dispenser_wash;                                                                                                                                                                                          │
│ 200 +         case RECIPE_WASH_STATION_WASH: // <-- Пример для существующей команды                                                                                                                                                        │
│ 201 +             return g_recipe_wash_station_wash;                                                                                                                                                                                       │
│ 202 +         case RECIPE_NEW_COMMAND: // <-- Ваш новый case                                                                                                                                                                               │
│ 203 +             return g_recipe_new_command;                                                                                                                                                                                             │
│ 204 +         default:                                                                                                                                                                                                                     │
│ 205 +             return NULL;                                                                                                                                                                                                             │
│ 206 +     }                                                                                                                                                                                                                                │
│ 207 + }                                                                                                                                                                                                                                    │
│ 208 + ```                                                                                                                                                                                                                                  │
